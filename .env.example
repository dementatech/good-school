# Copy this to .env in the same folder as docker-compose.yml — Docker
# Compose loads it automatically and substitutes these into the
# ${JWT_SECRET:-...} placeholders in docker-compose.yml.
#
# Generate real values with: openssl rand -hex 32
# Do NOT reuse the -dev-only- fallback values in docker-compose.yml for
# anything reachable from outside your machine.

JWT_SECRET=c6f2a750ab2794ded7641f80a85ac34d20ec0ed39acd153d68f0a85deb81eff6
COOKIE_SECRET=596c60c8cf12539d9e86cb5af6a7fc16d826fe7ecdee8300a250c7622666518c

# Required by docker-compose.prod.yml (the dev compose file hardcodes "postgres" instead)
POSTGRES_PASSWORD=

# Set to true only once the app is served over HTTPS (e.g. behind Caddy/nginx).
# Cookies won't be sent by the browser over plain HTTP if this is true.
COOKIE_SECURE=false

# Password-reset emails. Get an API key at https://resend.com (free tier is
# plenty to start). RESEND_FROM must be onboarding@resend.dev until you verify
# a domain. APP_URL is the public frontend URL the reset link points at — no
# trailing slash. Without RESEND_API_KEY the backend logs the link instead of
# emailing it.
RESEND_API_KEY=
RESEND_FROM=Good School <onboarding@resend.dev>
APP_URL=https://your-frontend-domain

# Schools' custom domains: this server's public IP, which a school's DNS record
# must point at, and addresses a school can't claim (comma-separated, besides
# APP_URL's own host).
SERVER_PUBLIC_IP=
PLATFORM_HOSTS=

# Host ports for docker-compose.prod.yml, bound to 127.0.0.1 only. Change them
# if another app on the server already uses or routes to 4000/3000.
BACKEND_PORT=4000
FRONTEND_PORT=3000

# File uploads (staff photos, school logos, academic documents). Set all
# three to send uploads to Cloudinary — get them from your Cloudinary
# dashboard. Leave blank to keep files on the backend-uploads disk volume
# instead (they survive redeploys but not a volume wipe). Nothing breaks
# either way.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
