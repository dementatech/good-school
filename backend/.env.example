# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_os

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-a-different-long-random-string
# Set to "true" once served over HTTPS (e.g. behind a TLS-terminating proxy)
COOKIE_SECURE=false

# Server
PORT=4000
NODE_ENV=development

# Email (password reset links). Without RESEND_API_KEY the message is logged
# instead of sent — fine for local dev. Get a key at https://resend.com.
RESEND_API_KEY=
RESEND_FROM=Good School <onboarding@resend.dev>
# Public base URL of the frontend — used to build the reset link in the email.
APP_URL=http://localhost:3000
