# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_os

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-a-different-long-random-string
# Set to "true" once served over HTTPS (e.g. behind a TLS-terminating proxy)
COOKIE_SECURE=false

# Server
PORT=4000
NODE_ENV=development

# Local-disk file uploads (staff photos, ...). Defaults to <cwd>/uploads,
# i.e. /app/uploads in the Docker image — mount that as a volume in
# production (see docker-compose.yml) or uploads vanish on redeploy.
UPLOADS_DIR=
