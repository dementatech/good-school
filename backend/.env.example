# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_os

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-a-different-long-random-string
# Set to "true" once served over HTTPS (e.g. behind a TLS-terminating proxy)
COOKIE_SECURE=false

# Server
PORT=4000
NODE_ENV=development

# Local-disk file uploads (staff photos, documents, ...). Defaults to
# <cwd>/uploads, i.e. /app/uploads in the Docker image — mount that as a
# volume in production (see docker-compose.yml) or files vanish on redeploy.
# This is the fallback used automatically whenever CLOUDINARY_* below isn't
# set — no action needed to keep uploads working without a Cloudinary account.
UPLOADS_DIR=

# Cloudinary (staff photos + academic documents). Get these from your
# Cloudinary dashboard. Leave unset to use local-disk storage instead —
# nothing breaks either way, this just upgrades where files are kept.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
