# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_os

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-a-different-long-random-string
# Set to "true" once served over HTTPS (e.g. behind a TLS-terminating proxy)
COOKIE_SECURE=false

# Server
PORT=4000
NODE_ENV=development
