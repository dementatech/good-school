{
  "name": "@school-os/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up --no-single-transaction",
    "migrate:down": "node-pg-migrate down --no-single-transaction",
    "create-super-admin": "tsx scripts/create-super-admin.ts",
    "set-platform-owner": "tsx scripts/set-platform-owner.ts",
    "set-support-agent": "tsx scripts/set-support-agent.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "seed-test-school": "tsx scripts/seed-test-school.ts",
    "seed-demo-junior-school": "tsx scripts/seed-demo-junior-school.ts",
    "seed-demo-primary-school": "tsx scripts/seed-demo-primary-school.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.1",
    "@react-pdf/renderer": "^4.9.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.6",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "puppeteer": "^25.11.0",
    "react": "^19.3.0",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3"
  }
}
